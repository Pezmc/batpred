// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3.11",
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			"settings": {
				"files.eol": "\n",
                "editor.tabSize": 4,
				"[python]": {
                    "diffEditor.ignoreTrimWhitespace": false,
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true
                }
			},
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-python.isort",
				"sourcery.sourcery",
				"njpwerner.autodocstring",
				"streetsidesoftware.code-spell-checker",
				"bierner.markdown-preview-github-styles",
				"DavidAnson.vscode-markdownlint",
				"eamodio.gitlens",
				"anthropic.claude-code"
			]
		}
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [9000],
	// Use 'portsAttributes' to set default properties for specific forwarded ports.
	// More info: https://containers.dev/implementors/json_reference/#port-attributes
	// "portsAttributes": {
	// 	"9000": {
	// 		"label": "Hello Remote World",
	// 		"onAutoForward": "notify"
	// 	}
	// },
	// Passthrough of SSH key to devcontainer
	"mounts": [
		"type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh_host,readonly"
	],
	// Use 'postCreateCommand' to run commands after the container is created.
	// SSH config is patched to strip macOS-only 'UseKeychain' option (not supported on Linux)
	"postCreateCommand": "mkdir -p ~/.ssh && echo 'IgnoreUnknown UseKeychain' > ~/.ssh/config && cat ~/.ssh_host/config >> ~/.ssh/config && find ~/.ssh_host -maxdepth 1 -type f ! -name config -exec cp {} ~/.ssh/ \\; && chmod 700 ~/.ssh && chmod 600 ~/.ssh/* && pip install --upgrade pip && pip3 install -r requirements.txt && npm install -g @anthropic-ai/claude-code"
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
